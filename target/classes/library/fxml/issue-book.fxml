<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="376.0" prefWidth="507.0" style="-fx-background-color: #0d1620;" stylesheets="@/library/css/issue-book.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.book.BookIssueController">
    <children>
        <Label alignment="CENTER" layoutX="138.0" prefHeight="62.0" prefWidth="205.0" text="BOOK ISSUE" textAlignment="CENTER">
            <font>
                <Font name="JetBrains Mono ExtraBold" size="29.0" />
            </font>
        </Label>
        <Label layoutX="33.0" layoutY="132.0" />
        <Button fx:id="yesButton" layoutX="156.0" layoutY="282.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="53.0" text="YES" />
        <Button fx:id="noButton" layoutX="388.0" layoutY="295.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="47.0" text="NO" />
        <Label alignment="CENTER" layoutX="194.0" layoutY="50.0" prefHeight="62.0" prefWidth="333.0" text="Are You Sure You Want to Issue the Book?">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="12.0" />
         </font></Label>
        <Label fx:id="lblDeadLine" alignment="CENTER" layoutX="151.0" layoutY="204.0" prefHeight="62.0" prefWidth="333.0" text="Time for before you have to submit">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="15.0" />
         </font></Label>
      <Label fx:id="lblError" layoutX="230.0" layoutY="250.0" prefHeight="33.0" prefWidth="283.0" />
      <ImageView fx:id="coverPage" fitHeight="193.0" fitWidth="156.0" layoutY="67.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="lblTitle" layoutX="252.0" layoutY="132.0" prefHeight="25.0" prefWidth="225.0" textFill="WHITE">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblLibCatalogue" layoutX="242.0" layoutY="155.0" prefHeight="25.0" prefWidth="225.0" text="Catalogue" textFill="WHITE">
         <font>
            <Font name="JetBrains Mono ExtraBold" size="12.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
