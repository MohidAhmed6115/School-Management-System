<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="756.0" prefWidth="1096.0" stylesheets="@../css/main-page.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.mainPageController">
   <children>
      <!-- Nav Bar -->
      <HBox id="navBar" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="70.0" minWidth="200.0" prefHeight="112.0" prefWidth="1096.0" spacing="8.0">
         <children>
            <Region prefHeight="102.0" prefWidth="12.0" />
            <ImageView fitHeight="79.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/books.png" />
               </image>
            </ImageView>
            <Region prefHeight="102.0" prefWidth="6.0" />
            <Label prefHeight="50.0" prefWidth="258.0" text="RIPHAH LIBRARY" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="27.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblDateTime" alignment="CENTER" prefHeight="46.0" prefWidth="225.0" stylesheets="@../css/main-page.css" />
            <Region prefHeight="102.0" prefWidth="8.0" />
            <Button fx:id="homeButton" mnemonicParsing="false" prefHeight="33.0" prefWidth="82.0" text="HOME">
               <font>
                  <Font name="Segoe UI Bold" size="12.0" />
               </font>
            </Button>
            <Region prefHeight="102.0" prefWidth="73.0" />
            <Region prefWidth="6.0" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <Region fx:id="accentStripe" prefHeight="0.0" prefWidth="1096.0" />

      <Region prefHeight="13.0" />

      <!-- Search Row - fully centered -->
      <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="61.0" spacing="10.0">
         <children>
            <ChoiceBox fx:id="searchChoice" prefHeight="33.0" prefWidth="140.0">
               <opaqueInsets>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </opaqueInsets>
               <cursor>
                  <Cursor fx:constant="DEFAULT" />
               </cursor>
            </ChoiceBox>
            <TextField fx:id="searchBar" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="792.0" HBox.hgrow="ALWAYS" />
            <Region prefHeight="61.0" prefWidth="75.0" />
         </children>
         <padding>
            <Insets left="40.0" right="40.0" />
         </padding>
      </HBox>

      <!-- Stats label - centered -->
      <HBox alignment="CENTER" prefHeight="32.0">
         <children>
            <Label fx:id="lblTotal" alignment="CENTER" prefHeight="37.0">
               <font>
                  <Font name="Segoe UI" size="10.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <!-- Table - centered and fills remaining space -->
      <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="table" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="10.0" left="40.0" right="40.0" />
         </padding>
         <VBox.margin>
