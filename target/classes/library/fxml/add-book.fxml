<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="460.0" prefWidth="560.0" stylesheets="@/library/css/popup.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.librarian.AddBookController">

    <!-- ── TOP: Nav Bar + Accent Stripe ── -->
    <top>
        <VBox>
            <HBox fx:id="navBar" alignment="CENTER" prefHeight="56.0" prefWidth="560.0">
                <Label alignment="CENTER" prefWidth="560.0" text="BOOK ADDITION" textAlignment="CENTER">
                    <font><Font name="Segoe UI Bold" size="22.0" /></font>
                </Label>
            </HBox>
            <Region fx:id="accentStripe" prefWidth="560.0" />
        </VBox>
    </top>

    <!-- ── CENTER: Content Pane ── -->
    <center>
        <VBox fx:id="contentPane" spacing="16.0" style="-fx-padding: 20 28 20 28;">

            <!-- Section Heading -->
            <Label styleClass="section-heading" text="DETAILS" />

            <!-- ── Form Grid ── -->
            <GridPane hgap="20.0" vgap="6.0">
                <columnConstraints>
                    <ColumnConstraints prefWidth="236.0" />
                    <ColumnConstraints prefWidth="236.0" />
                </columnConstraints>

                <!-- Row 0: Year Published | Author Name -->
                <Label styleClass="field-label" text="Year Published" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label styleClass="field-label" text="Author Name" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- Row 1 -->
                <Spinner fx:id="onlyYearSpinner" editable="true" prefHeight="32.0" prefWidth="200.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="authorNameField" prefHeight="32.0" prefWidth="200.0" promptText="e.g. J.K. Rowling" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <!-- Row 2: Book Name | Cover Page -->
                <Label style="-fx-padding: 8 0 0 0;" styleClass="field-label" text="Book Name" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label style="-fx-padding: 8 0 0 0;" styleClass="field-label" text="Cover Page" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <!-- Row 3 -->
                <TextField fx:id="bookNameField" prefHeight="32.0" prefWidth="200.0" promptText="Enter book title" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Button fx:id="imageChooser" mnemonicParsing="false" onAction="#chooseImage" prefHeight="32.0" prefWidth="160.0" text="Choose Cover Page" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <!-- Row 4: Category | No. Of Copies -->
                <Label style="-fx-padding: 8 0 0 0;" styleClass="field-label" text="Category" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label style="-fx-padding: 8 0 0 0;" styleClass="field-label" text="No. Of Copies" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <!-- Row 5 -->
                <ComboBox fx:id="categoryComboBox" prefWidth="200.0" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <Spinner fx:id="noOfCopiesSpinner" prefHeight="32.0" prefWidth="160.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>
         <Region prefHeight="14.0" prefWidth="504.0" />

            <!-- ── Bottom Row: Warning + Done ── -->
            <HBox alignment="CENTER" spacing="16.0" style="-fx-padding: 4 0 0 0;">
                <Label fx:id="lblWarning" maxWidth="280.0" prefHeight="28.0" wrapText="true">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>
                <Button fx:id="doneButton" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" text="DONE" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
