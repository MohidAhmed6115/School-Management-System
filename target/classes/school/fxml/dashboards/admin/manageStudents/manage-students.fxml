<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@/school/css/dashboards/admin/admin-dashboard.css, @/school/css/dashboards/admin/manageStudents/manage-students.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controller.dashboards.admin.manageStudents.ManageStudentController">

    <!-- ═══════════════════════════════════════
         NAV BAR
    ═══════════════════════════════════════ -->
    <HBox fx:id="navBar" alignment="CENTER_LEFT" spacing="12" styleClass="nav-bar">

        <!-- Brand label -->
        <Label alignment="CENTER_RIGHT" contentDisplay="RIGHT" prefHeight="17.0" prefWidth="97.0"
               styleClass="brand-title" text="SchoolAdmin"/>

        <!-- Spacer: pushes everything after it to the right -->
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Logout button -->
        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-button"
                text="Logout"/>

        <!-- User avatar image -->
        <ImageView fitHeight="32" fitWidth="32" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/User.png"/>
            </image>
        </ImageView>

        <!-- Username label -->
        <Label fx:id="usernameLabel" styleClass="username-label" text="Admin User"/>

        <!-- Profile dropdown -->
        <MenuButton fx:id="topMenuButton" mnemonicParsing="false" styleClass="top-menu-button">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleProfileButton" text="Profile"/>
                <MenuItem mnemonicParsing="false" onAction="#handleChangePasswordButton" text="Change Password"/>
            </items>
        </MenuButton>

    </HBox>


    <!-- ═══════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════ -->
    <VBox spacing="20" styleClass="content-area" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="24" left="24" right="24" top="24"/>
        </padding>


        <!-- ── Stats Row ── -->
        <HBox spacing="12">

            <VBox spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="TOTAL Students"/>
                <Label styleClass="stat-value" text="76"/>
                <Label styleClass="stat-badge stat-badge-up" text="+2 new"/>
            </VBox>
            <VBox spacing="4" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="ATTENDANCE TODAY"/>
                <Label styleClass="stat-value" text="94%"/>
                <Label styleClass="stat-badge stat-badge-up" text="Above average"/>
            </VBox>

        </HBox>


        <!-- ── Action Cards Row ── -->
        <HBox spacing="14">

            <VBox fx:id="enrollStudentsButton" onMouseClicked="#enrollStudents" spacing="8"
                  style="-fx-background-color: white;" styleClass="action-card" HBox.hgrow="ALWAYS">
                <Label styleClass="action-title" text="Enroll Students"/>
                <Label styleClass="action-sub" text="Enroll a student to student records" wrapText="true"/>
                <Label styleClass="action-arrow" text="Open →"/>
            </VBox>

            <VBox fx:id="removeStudentsButton" onMouseClicked="#removeStudents" spacing="8" styleClass="action-card"
                  HBox.hgrow="ALWAYS">
                <Label styleClass="action-title" text="Remove Students"/>
                <Label styleClass="action-sub" text="Remove a student to student records" wrapText="true"/>
                <Label styleClass="action-arrow" text="Open →"/>
            </VBox>

            <VBox fx:id="viewStudentsButton" onMouseClicked="#viewStudents" spacing="8" styleClass="action-card"
                  HBox.hgrow="ALWAYS">
                <Label styleClass="action-title" text="View Students"/>
                <Label styleClass="action-sub" text="Search any student from student records" wrapText="true"/>
                <Label styleClass="action-arrow" text="Open →"/>
            </VBox>

        </HBox>
        <HBox alignment="BOTTOM_LEFT" prefHeight="36.0" prefWidth="611.0">
            <children>
                <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#handleGoBack" text="← Go Back"/>
            </children>
        </HBox>

    </VBox>

</VBox>
