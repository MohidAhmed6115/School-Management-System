<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="removeTeacherPopUp" stylesheets="@/school/css/dashboards/admin/manageTeachers/remove-teachers.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.dashboards.admin.manageTeachers.RemoveTeachers">

    <AnchorPane prefHeight="400.0" prefWidth="340.0">

        <!-- ── Heading ── -->
        <Label fx:id="heading" alignment="CENTER" layoutX="29.0" layoutY="20.0" prefHeight="38.0" prefWidth="282.0" styleClass="textLabels" text="Remove a Teacher">
            <font><Font size="18.0" /></font>
        </Label>

        <!-- ── Subtitle / feedback message ── -->
        <Label fx:id="invalidMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="0.0" layoutY="68.0" prefHeight="44.0" prefWidth="340.0" text="Enter the following information to remove the Teacher" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
            <font><Font size="12.0" /></font>
        </Label>

        <!-- ── Name label ── -->
        <Label layoutX="29.0" layoutY="122.0" styleClass="textLabels" text="Full Name" />

        <!-- ── Name field ── -->
        <TextField fx:id="nameField" layoutX="29.0" layoutY="140.0" prefHeight="42.0" prefWidth="282.0" promptText="Enter Name" />

        <!-- ── OR divider ── -->
        <Label fx:id="textLabel" layoutX="160.0" layoutY="192.0" styleClass="orLabel" text="OR" />

        <!-- ── SAP ID label ── -->
        <Label layoutX="29.0" layoutY="212.0" styleClass="textLabels" text="SAP ID" />

        <!-- ── SAP ID field ── -->
        <TextField fx:id="sapIdField" layoutX="29.0" layoutY="230.0" prefHeight="42.0" prefWidth="282.0" promptText="Enter SAP ID" />

        <!-- ── Teacher Info VBox ── -->
        <VBox fx:id="teacherInfo" layoutX="29.0" layoutY="122.0" prefHeight="164.0" prefWidth="282.0" styleClass="teacherInfoBox" visible="false">
            <children>
                <HBox alignment="CENTER" prefHeight="47.0" prefWidth="282.0">
                    <children>
                        <Label fx:id="teacherInfoHeading" styleClass="teacherInfoHeading" text="Teacher Information" underline="true" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="282.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="teacherInfoType" text="Name: " />
                        <Label fx:id="teacherName" prefHeight="17.0" prefWidth="162.0" styleClass="teacherInfoContent" text="Teacher Name" textOverrun="CLIP" wrapText="true" />
                    </children>
                    <padding><Insets left="10.0" /></padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="282.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="teacherInfoType" text="SAP ID:" />
                        <Label fx:id="teacherSapId" styleClass="teacherInfoContent" text="Teacher SAP ID" />
                    </children>
                    <padding><Insets left="10.0" /></padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="282.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="teacherInfoType" text="Salary:" />
                        <Label fx:id="teacherSalary" styleClass="teacherInfoContent" text="Teacher Salary" />
                    </children>
                    <padding><Insets left="10.0" /></padding>
                </HBox>
            </children>
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
        </VBox>

        <!-- ── Buttons ── -->
        <Button fx:id="okButton" layoutX="50.0" layoutY="325.0" mnemonicParsing="false" onAction="#checkTeacherInfo" prefHeight="38.0" prefWidth="120.0" text="OK">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="confirmButton" layoutX="50.0" layoutY="325.0" mnemonicParsing="false" onAction="#manageRemoveTeacher" prefHeight="38.0" prefWidth="120.0" text="Confirm" visible="false">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="cancelButton" layoutX="200.0" layoutY="325.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Cancel">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="closeButton" layoutX="125.0" layoutY="325.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Close" visible="false">
            <font><Font size="13.0" /></font>
        </Button>

    </AnchorPane>
</StackPane>