<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="addTeacherPopUp" prefHeight="400.0" prefWidth="323.0" stylesheets="@/school/css/popUpWindows/popup-window.css, @/school/css/dashboards/admin/manageTeachers/add-teachers.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.dashboards.admin.manageTeachers.AddTeachers">
     <Label fx:id="heading" alignment="CENTER" layoutX="29.0" layoutY="44.0" prefHeight="35.0" prefWidth="265.0" styleClass="textLabels" text="Add a Teacher">
         <font>
             <Font size="24.0" />
         </font>
     </Label>
     <Button fx:id="cancelButton" layoutX="193.0" layoutY="337.0" mnemonicParsing="false" onAction="#handleClose" text="Cancel">
         <font>
             <Font size="14.0" />
         </font>
     </Button>
     <Button fx:id="confirmButton" layoutX="58.0" layoutY="337.0" mnemonicParsing="false" onAction="#manageAddTeacher" text="Confirm">
         <font>
             <Font size="14.0" />
         </font>
     </Button>
     <Label fx:id="invalidMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="12.0" layoutY="89.0" prefHeight="76.0" prefWidth="299.0" text="Enter the following information to add the Teacher" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
         <font>
             <Font size="14.0" />
         </font>
     </Label>
     <Button fx:id="closeButton" layoutX="126.0" layoutY="337.0" mnemonicParsing="false" onAction="#handleClose" text="Close" visible="false">
         <font>
             <Font size="14.0" />
         </font>
     </Button>
   <TextField fx:id="nameField" layoutX="78.0" layoutY="183.0" prefHeight="35.0" prefWidth="167.0" promptText="Enter Full Name" />
   <TextField fx:id="salaryField" layoutX="78.0" layoutY="239.0" prefHeight="35.0" prefWidth="167.0" promptText="Enter Salary" />
</AnchorPane>
