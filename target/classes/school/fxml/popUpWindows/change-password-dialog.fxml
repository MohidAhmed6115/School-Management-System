<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="changePasswordPopUp" prefHeight="400.0" prefWidth="323.0" stylesheets="@/school/css/popUpWindows/popup-window.css, @/school/css/popUpWindows/change-password-window.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.popUpWindows.ChangePasswordDialogController">
    <StackPane alignment="CENTER_RIGHT" layoutX="29.0" layoutY="135.0" prefHeight="58.0" prefWidth="265.0">
        <children>

            <TextField fx:id="userPasswordVisible" managed="false" prefHeight="42.0" prefWidth="257.0" promptText="Enter current password" visible="false" />
            <PasswordField fx:id="userPassword" prefHeight="42.0" prefWidth="257.0" promptText="Enter current password" />

            <Button fx:id="togglePassword" onAction="#handleTogglePassword" prefHeight="42.0" prefWidth="53.0" style="-fx-background-color: transparent;" text="👁" textFill="BLUE">
                <font>
                    <Font size="19.0" />
                </font>
            </Button>
        </children>
    </StackPane>
   <StackPane alignment="CENTER_RIGHT" layoutX="29.0" layoutY="215.0" prefHeight="58.0" prefWidth="265.0">
      <children>
         <TextField fx:id="newPasswordVisible" managed="false" prefHeight="42.0" prefWidth="257.0" promptText="Enter new password" visible="false" />
         <PasswordField fx:id="newPassword" prefHeight="42.0" prefWidth="257.0" promptText="Enter new password" />
         <Button fx:id="toggleNewPassword" onAction="#handleTogglePassword" prefHeight="42.0" prefWidth="53.0" style="-fx-background-color: transparent;" text="👁" textFill="BLUE">
            <font>
               <Font size="19.0" />
            </font>
         </Button>
      </children>
   </StackPane>
   <StackPane alignment="CENTER_RIGHT" layoutX="29.0" layoutY="273.0" prefHeight="58.0" prefWidth="265.0">
      <children>
         <TextField fx:id="confirmNewPasswordVisible" managed="false" prefHeight="42.0" prefWidth="257.0" promptText="Confirm new password" visible="false" />
         <PasswordField fx:id="confirmNewPassword" prefHeight="42.0" prefWidth="257.0" promptText="Confirm new password" />
         <Button fx:id="toggleConfirmNewPassword" onAction="#handleTogglePassword" prefHeight="42.0" prefWidth="53.0" style="-fx-background-color: transparent;" text="👁" textFill="BLUE">
            <font>
               <Font size="19.0" />
            </font>
         </Button>
      </children>
   </StackPane>
   <Label layoutX="29.0" layoutY="200.0" styleClass="textLabels" text="New Password" />
   <Label fx:id="heading" alignment="CENTER" layoutX="29.0" layoutY="21.0" prefHeight="35.0" prefWidth="265.0" styleClass="textLabels" text="Change Password">
      <font>
         <Font size="24.0" />
      </font>
   </Label>
   <Button fx:id="cancelButton" layoutX="183.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleClose" text="Cancel">
      <font>
         <Font size="14.0" />
      </font></Button>
   <Button fx:id="confirmButton" layoutX="75.0" layoutY="352.0" mnemonicParsing="false" onAction="#managePasswordFields" text="Confirm">
      <font>
         <Font size="14.0" />
      </font></Button>
   <Label fx:id="invalidMessage" alignment="CENTER" contentDisplay="CENTER" layoutY="61.0" prefHeight="76.0" prefWidth="323.0" text="Enter the following to change the PASSWORD" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
      <font>
         <Font size="14.0" />
      </font>
   </Label>
   <Button fx:id="closeButton" layoutX="129.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleClose" text="Close" visible="false">
      <font>
         <Font size="14.0" />
      </font>
   </Button>
</AnchorPane>
