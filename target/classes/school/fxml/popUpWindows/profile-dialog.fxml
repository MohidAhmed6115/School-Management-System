<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="profilePopUp" alignment="CENTER" fillWidth="false" prefHeight="372.0" prefWidth="346.0" stylesheets="@/school/cssool/css/popUpWindows/popup/school/cssdow.css, @/css/popUpWindows/profile-window.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.popUpWindows.ProfileDialogController">
    <children>
        <HBox alignment="CENTER" minHeight="67.0" prefHeight="52.0" prefWidth="310.0">
            <children>
                <Label fx:id="heading" alignment="CENTER" contentDisplay="CENTER" prefHeight="28.0" prefWidth="92.0" text="Profile">
                    <font>
                        <Font size="19.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        <VBox fx:id="userInformation" alignment="CENTER" prefWidth="322.0">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="67.0" prefHeight="67.0" prefWidth="332.0">
                    <children>
                        <Label prefWidth="100.0" styleClass="informationType" text="Name:">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="userNameLabel" layoutX="20.0" layoutY="35.0" styleClass="userInformation" text="User Name" />
                    </children>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="158.0" minHeight="67.0" prefHeight="67.0" prefWidth="332.0">
                    <children>
                        <Label prefWidth="100.0" styleClass="informationType" text="SAP ID:">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="userSapIdLabel" layoutX="20.0" layoutY="35.0" styleClass="userInformation" text="User SAP ID" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="191.0" minHeight="67.0" prefHeight="67.0" prefWidth="332.0">
                    <children>
                        <Label prefWidth="100.0" styleClass="informationType" text="Email:">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="userEmailLabel" layoutX="20.0" layoutY="35.0" styleClass="userInformation" text="User Email" />
                    </children>
                </HBox>
                <HBox fx:id="departmentRow" alignment="CENTER_LEFT" layoutX="10.0" layoutY="225.0" managed="false" minHeight="67.0" prefHeight="67.0" prefWidth="332.0" visible="false">
                    <children>
                        <Label prefWidth="100.0" styleClass="informationType" text="Department:">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="userDepartmentLabel" layoutX="20.0" layoutY="35.0" styleClass="userInformation" text="User Department" />
                    </children>
                </HBox>
                <HBox fx:id="salaryRow" alignment="CENTER_LEFT" layoutX="10.0" layoutY="258.0" managed="false" minHeight="67.0" prefHeight="67.0" prefWidth="332.0" visible="false">
                    <children>
                        <Label prefWidth="100.0" styleClass="informationType" text="Salary:">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Label fx:id="userSalaryLabel" layoutX="20.0" layoutY="35.0" styleClass="userInformation" text="User Salary" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" minHeight="47.0" prefHeight="47.0" prefWidth="310.0">
            <children>
                <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" text="Close">
               <font>
                  <Font size="14.0" />
               </font></Button>
            </children>
            <VBox.margin>
                <Insets bottom="6.0" top="8.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
