<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="addTeacherPopUp" stylesheets="@/school/css/dashboards/admin/manageTeachers/add-teachers.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.dashboards.admin.manageTeachers.AddTeachers">

    <AnchorPane prefHeight="400.0" prefWidth="340.0">

        <!-- ── Heading ── -->
        <Label fx:id="heading" alignment="CENTER" layoutX="29.0" layoutY="20.0" prefHeight="38.0" prefWidth="282.0" styleClass="textLabels" text="Add a Teacher">
            <font><Font size="18.0" /></font>
        </Label>

        <!-- ── Subtitle / feedback message ── -->
        <Label fx:id="invalidMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="0.0" layoutY="68.0" prefHeight="44.0" prefWidth="340.0" text="Enter the following information to add the Teacher" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
            <font><Font size="12.0" /></font>
        </Label>

        <!-- ── Name label ── -->
        <Label layoutX="29.0" layoutY="122.0" styleClass="textLabels" text="Full Name" />

        <!-- ── Name field ── -->
        <TextField fx:id="nameField" layoutX="29.0" layoutY="140.0" prefHeight="42.0" prefWidth="282.0" promptText="Enter Full Name" />

        <!-- ── Salary label ── -->
        <Label layoutX="29.0" layoutY="196.0" styleClass="textLabels" text="Salary" />

        <!-- ── Salary field ── -->
        <TextField fx:id="salaryField" layoutX="29.0" layoutY="214.0" prefHeight="42.0" prefWidth="282.0" promptText="Enter Salary" />

        <!-- ── Buttons ── -->
        <Button fx:id="confirmButton" layoutX="50.0" layoutY="310.0" mnemonicParsing="false" onAction="#manageAddTeacher" prefHeight="38.0" prefWidth="120.0" text="Confirm">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="cancelButton" layoutX="200.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Cancel">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="closeButton" layoutX="125.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Close" visible="false">
            <font><Font size="13.0" /></font>
        </Button>

    </AnchorPane>
</StackPane>