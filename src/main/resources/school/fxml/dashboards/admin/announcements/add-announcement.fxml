<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="addAnnouncementPopUp" stylesheets="@../../../../css/dashboards/admin/announcements/add-announcement.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.school.controller.dashboards.admin.announcements.AddAnnouncementController">

    <AnchorPane prefHeight="400.0" prefWidth="340.0">

        <!-- ── Heading ── -->
        <Label fx:id="heading" alignment="CENTER" layoutX="29.0" layoutY="20.0" prefHeight="38.0" prefWidth="282.0" styleClass="textLabels" text="Add Announcement">
            <font><Font size="18.0" /></font>
        </Label>

        <!-- ── Subtitle / feedback message ── -->
        <Label fx:id="invalidMessage" alignment="CENTER" contentDisplay="CENTER" layoutX="0.0" layoutY="68.0" prefHeight="44.0" prefWidth="340.0" text="Enter the following information to add announcement" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
            <font><Font size="12.0" /></font>
        </Label>

        <!-- ── Message label ── -->
        <Label alignment="CENTER" layoutX="29.0" layoutY="122.0" prefHeight="16.0" prefWidth="282.0" styleClass="textLabels" text="Enter message" />

        <!-- ── Message field ── -->
        <TextField fx:id="messageField" layoutX="29.0" layoutY="140.0" prefHeight="42.0" prefWidth="282.0" promptText="Enter Your Message" />

        <!-- ── Department label ── -->
        <Label alignment="CENTER" layoutX="25.0" layoutY="207.0" prefHeight="16.0" prefWidth="183.0" styleClass="textLabels" text="Date" />

        <!-- ── Buttons ── -->
        <Button fx:id="confirmButton" layoutX="50.0" layoutY="310.0" mnemonicParsing="false" onAction="#manageAddAnnouncement" prefHeight="38.0" prefWidth="120.0" text="Confirm">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="cancelButton" layoutX="200.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Cancel">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="closeButton" layoutX="200.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="38.0" prefWidth="90.0" text="Close" visible="false">
            <font><Font size="13.0" /></font>
        </Button>

        <Button fx:id="addAgainButton" layoutX="56.0" layoutY="310.0" mnemonicParsing="false" onAction="#handleAddAgainButton" prefHeight="38.0" prefWidth="96.0" text="New" visible="false">
            <font><Font size="13.0" /></font>
        </Button>
      <DatePicker fx:id="dateField" layoutX="29.0" layoutY="232.0" prefHeight="42.0" prefWidth="183.0" />
      <Spinner fx:id="importanceField" layoutX="231.0" layoutY="232.0" prefHeight="42.0" prefWidth="79.0" />
      <Label alignment="CENTER" layoutX="226.0" layoutY="207.0" prefHeight="16.0" prefWidth="90.0" styleClass="textLabels" text="Importance" />

    </AnchorPane>
</StackPane>
