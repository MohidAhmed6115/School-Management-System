<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="310.0" prefWidth="460.0"
            stylesheets="@../css/popup.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.book.BookIssueController">

    <!-- ── TOP: Nav Bar + Accent Stripe ── -->
    <top>
        <VBox>
            <HBox fx:id="navBar" alignment="CENTER" prefHeight="56.0" prefWidth="460.0">
                <Label text="BOOK ISSUE" alignment="CENTER" prefWidth="460.0"
                       textAlignment="CENTER">
                    <font><Font name="Segoe UI Bold" size="22.0" /></font>
                </Label>
            </HBox>
            <Region fx:id="accentStripe" prefWidth="460.0" />
        </VBox>
    </top>

    <!-- ── CENTER: Content Pane ── -->
    <center>
        <HBox fx:id="contentPane" alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-padding: 16 20 16 20;">

            <!-- ── Book Cover ── -->
            <ImageView fx:id="coverPage"
                       fitHeight="160.0" fitWidth="110.0"
                       pickOnBounds="true" preserveRatio="true" />

            <!-- ── Book Info + Actions ── -->
            <VBox alignment="TOP_LEFT" spacing="6.0"
                  style="-fx-padding: 4 0 0 0;">

                <Label fx:id="lblTitle" text="Title"
                       prefHeight="22.0" maxWidth="280.0" wrapText="true">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Label>

                <Label fx:id="lblLibCatalogue" text="Catalogue"
                       prefHeight="20.0" maxWidth="280.0">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>

                <!-- Divider-like spacer -->
                <Region prefHeight="6.0" />

                <Label fx:id="lblDeadLine" alignment="CENTER"
                       text="— days remaining —"
                       prefHeight="30.0" maxWidth="280.0">
                    <font><Font name="Segoe UI Bold" size="16.0" /></font>
                </Label>

                <Label fx:id="lblError" prefHeight="20.0" maxWidth="280.0">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>

                <Label fx:id="lblQuestion" alignment="CENTER"
                       text="Are you sure you want to issue this book?"
                       prefHeight="20.0" maxWidth="280.0" wrapText="true">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>

                <!-- ── YES / NO Buttons ── -->
                <HBox spacing="12.0" style="-fx-padding: 6 0 0 0;">
                    <Button fx:id="yesButton"
                            mnemonicParsing="false"
                            prefHeight="34.0" prefWidth="90.0"
                            text="YES" />
                    <Button fx:id="noButton"
                            mnemonicParsing="false"
                            prefHeight="34.0" prefWidth="90.0"
                            text="NO" />
                </HBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
