            <Button fx:id="removeBookButton" contentDisplay="LEFT" graphicTextGap="8.0" mnemonicParsing="false" prefHeight="42.0" prefWidth="195.0" text="REMOVE BOOK">
               <graphic>
                  <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" scaleX="0.85" scaleY="0.85" styleClass="btn-icon" />
