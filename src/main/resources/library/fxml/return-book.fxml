<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="320.0" prefWidth="440.0"
            stylesheets="@/library/css/popup.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.librarian.ReturnBookController">

    <!-- ── TOP: Nav Bar + Accent Stripe ── -->
    <top>
        <VBox>
            <HBox fx:id="navBar" alignment="CENTER" prefHeight="56.0" prefWidth="440.0">
                <Label text="BOOK RETURN" alignment="CENTER" prefWidth="440.0"
                       textAlignment="CENTER">
                    <font><Font name="Segoe UI Bold" size="22.0" /></font>
                </Label>
            </HBox>
            <Region fx:id="accentStripe" prefWidth="440.0" />
        </VBox>
    </top>

    <!-- ── CENTER: Content Pane ── -->
    <center>
        <VBox fx:id="contentPane" spacing="16.0"
              style="-fx-padding: 20 28 20 28;">

            <!-- Section Heading -->
            <Label text="DETAILS" styleClass="section-heading" />

            <!-- ── Form Grid ── -->
            <GridPane hgap="20.0" vgap="6.0">
                <columnConstraints>
                    <ColumnConstraints prefWidth="360.0" />
                </columnConstraints>

                <!-- Row 0: SAP ID -->
                <Label text="SAP ID" styleClass="field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="sapTextField"
                           prefHeight="32.0" prefWidth="360.0"
                           promptText="Enter student SAP ID"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <!-- Row 2: Lib Catalogue -->
                <Label text="LIB CATALOGUE" styleClass="field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-padding: 8 0 0 0;" />
                <TextField fx:id="libCatalogueField"
                           prefHeight="32.0" prefWidth="360.0"
                           promptText="Enter library catalogue number"
                           GridPane.columnIndex="0" GridPane.rowIndex="3" />

                <!-- Validation feedback -->
                <Label fx:id="lblValidation" prefHeight="24.0" prefWidth="360.0"
                       GridPane.columnIndex="0" GridPane.rowIndex="4"
                       style="-fx-padding: 4 0 0 0;">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>

            </GridPane>

            <!-- ── Bottom Row: Warning + Done ── -->
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-padding: 4 0 0 0;">
                <Label fx:id="lblWarning" prefHeight="28.0" maxWidth="240.0"
                       wrapText="true">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="doneButton"
                        mnemonicParsing="false"
                        prefHeight="36.0" prefWidth="110.0"
                        text="DONE" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
