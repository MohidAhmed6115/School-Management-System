<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="340.0" prefWidth="500.0"
            stylesheets="@/library/css/popup.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.librarian.RemoveBookController">

    <!-- ── TOP: Nav Bar + Accent Stripe ── -->
    <top>
        <VBox>
            <HBox fx:id="navBar" alignment="CENTER" prefHeight="56.0" prefWidth="500.0">
                <Label text="BOOK REMOVAL" alignment="CENTER" prefWidth="500.0"
                       textAlignment="CENTER">
                    <font><Font name="Segoe UI Bold" size="22.0" /></font>
                </Label>
            </HBox>
            <Region fx:id="accentStripe" prefWidth="500.0" />
        </VBox>
    </top>

    <!-- ── CENTER: Content Pane ── -->
    <center>
        <VBox fx:id="contentPane" spacing="16.0"
              style="-fx-padding: 20 28 20 28;">

            <!-- Section Heading -->
            <Label text="DETAILS" styleClass="section-heading" />

            <!-- ── Form Grid ── -->
            <GridPane hgap="20.0" vgap="6.0">
                <columnConstraints>
                    <ColumnConstraints prefWidth="210.0" />
                    <ColumnConstraints prefWidth="210.0" />
                </columnConstraints>

                <!-- Row 0: Book Name | Author Name -->
                <Label text="Book Name" styleClass="field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label text="Author Name" styleClass="field-label"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- Row 1 -->
                <TextField fx:id="bookNameField"
                           prefHeight="32.0" prefWidth="200.0"
                           promptText="Enter book title"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="authorNameField"
                           prefHeight="32.0" prefWidth="200.0"
                           promptText="Enter author name"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <!-- Row 2: Category -->
                <Label text="Category" styleClass="field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-padding: 8 0 0 0;" />

                <!-- Row 3 -->
                <ComboBox fx:id="categoryComboBox" prefWidth="200.0"
                          GridPane.columnIndex="0" GridPane.rowIndex="3" />

            </GridPane>

            <!-- ── Bottom Row: Warning + Done ── -->
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-padding: 12 0 0 0;">
                <Label fx:id="lblWarning" prefHeight="28.0" maxWidth="260.0"
                       wrapText="true">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="doneButton"
                        mnemonicParsing="false"
                        prefHeight="36.0" prefWidth="110.0"
                        text="DONE" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
